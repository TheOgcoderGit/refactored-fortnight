# ChannelFlow AI - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git.
# 
# This file is organized by section. All values are placeholders - 
# replace them with your actual configuration.

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT
# -----------------------------------------------------------------------------
# Get BOT_TOKEN from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get API_ID and API_HASH from https://my.telegram.org
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# Name of the local .session file used by the Telethon account
# Created the first time you run: python -m core.authorize
SESSION_NAME=ChannelFlow

# -----------------------------------------------------------------------------
# 2. TELEGRAM API / TELETHON (Client configuration)
# -----------------------------------------------------------------------------
# SESSION_ENCRYPTION_KEY is required for /connect flow.
# Generate with: python -c "from cryptography.fernet import Fernet; 
# print(Fernet.generate_key().decode())"
# If unset, /connect flow is disabled (RuntimeWarning issued).
# WARNING: Losing this key means connected users' sessions become 
# undecryptable.
SESSION_ENCRYPTION_KEY=YOUR_SESSION_ENCRYPTION_KEY_HERE

# -----------------------------------------------------------------------------
# 3. DATABASE
# -----------------------------------------------------------------------------
# SQLite database file path
DB_NAME=channelflow.db

# -----------------------------------------------------------------------------
# 4. ADMIN / OWNER SECURITY
# -----------------------------------------------------------------------------
# Comma-separated list of Telegram user ids allowed to use /admin
# e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Owner identification (3-step challenge implemented in owner_panel.py)
# OWNER_ID is checked first; if set, owner authentication is enabled.
# When OWNER_ID is set, the bot enforces 3-step authentication for
# owner-level actions.
OWNER_ID=0

# Username for owner authentication (step 2 of 3)
OWNER_USERNAME=

# Password hash for owner authentication (step 3 of 3)
# Generate with: python -c "from hashlib import sha256; 
# print(sha256('your_password'.hexdigest()))"
OWNER_PASSWORD_HASH=

# Security answer hash (step 3 verification)
# Generate with: python -c "from hashlib import sha256; 
# print(sha256 'your_answer'.hexdigest())"
OWNER_SECURITY_ANSWER_HASH=

# Max failed owner-auth attempts before temporary cooldown
OWNER_MAX_ATTEMPTS=5

# Lockout duration in seconds after max attempts exceeded
OWNER_LOCKOUT_SECONDS=300

# -----------------------------------------------------------------------------
# 5. USER SESSION ENCRYPTION
# -----------------------------------------------------------------------------
# (See SESSION_ENCRYPTION_KEY in section 2 above)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 6. PAYMENTS — UPI
# -----------------------------------------------------------------------------
# UPI ID for receiving manual UPI payments (e.g. 
# upi@yourbank)
UPI_ID=

# Payee name displayed to users for UPI payments
UPI_PAYEE_NAME=Your Company Name

# -----------------------------------------------------------------------------
# 7. PAYMENTS — OXAPAY / CRYPTO
# -----------------------------------------------------------------------------
# Oxapay API key for crypto payments (optional)
OXAPAY_API_KEY=

# -----------------------------------------------------------------------------
# 8. TELEGRAM STARS
# -----------------------------------------------------------------------------
# Stars pricing is stored in the database (plan_configs table and 
# extra_forward_packages table), NOT via environment variables.
# Pricing is admin-configurable through the bot interface.
# 
# Default AI model used by the AI rewriter (Google AI Studio / Gemini).
AI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 9. AI / GOOGLE AI STUDIO (GEMINI)
# -----------------------------------------------------------------------------
# Gemini is the AI provider for BOTH the AI rewriter (Project > AI Tools)
# and the Support AI chatbot. Get a key from https://aistudio.google.com/apikey
# Without it both features stay disabled - forwarding is never blocked.
GEMINI_API_KEY=

# Optional comma-separated fallback models, tried in order when the primary
# model is unavailable (e.g. quota exhausted).
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-1.5-flash

# Legacy OpenRouter key. No longer called by the app; kept only so an
# existing .env does not break on startup.
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# 10. SUPPORT AI
# -----------------------------------------------------------------------------
# Model used by the Support AI chatbot (defaults to AI_MODEL).
SUPPORT_AI_MODEL=gemini-2.0-flash

# Support AI daily conversation limit per user
SUPPORT_AI_DAILY_LIMIT=50

# Max message length for Support AI (characters)
SUPPORT_AI_MAX_MESSAGE_LENGTH=2000

# Max response tokens for Support AI
SUPPORT_AI_MAX_RESPONSE_TOKENS=512

# Request timeout in seconds for Support AI calls
SUPPORT_AI_REQUEST_TIMEOUT=30

# Primary Support AI model
SUPPORT_AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Fallback Support AI models (ordered by preference)
# These are hardcoded fallback models; the env vars above take precedence
SUPPORT_AI_FALLBACK_MODELS="meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free"

# -----------------------------------------------------------------------------
# 11. WHATSAPP BUSINESS CLOUD API
# -----------------------------------------------------------------------------
# Phone number ID from Meta Business Manager
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID=

# WhatsApp Access Token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 12. WHATSAPP PAIRING SERVER
# -----------------------------------------------------------------------------
# Pairing code expiry in minutes (default 10 minutes)
PAIRING_CODE_EXPIRY_MINUTES=10

# HMAC secret for signing pairing codes (generate with:
# python -c "import secrets; print(secrets.token_hex(32))")
# The WhatsApp bot uses this to verify pairing codes were issued
# by this server (replay/cross-user protection).
PAIRING_HMAC_SECRET=

# Standalone pairing server bind address
PAIRING_SERVER_HOST=0.0.0.0

# Standalone pairing server port
PAIRING_SERVER_PORT=8081

# -----------------------------------------------------------------------------
# 13. META API (Instagram & Threads)
# -----------------------------------------------------------------------------
# Instagram Business Account
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Meta Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=

# -----------------------------------------------------------------------------
# 14. FX / CURRENCY CONFIGURATION
# -----------------------------------------------------------------------------
# INR to USD exchange rate (default 85)
INR_PER_USD=85

# -----------------------------------------------------------------------------
# INSTRUCTIONS
# -----------------------------------------------------------------------------
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the REQUIRED variables (marked above)
# 3. Install requirements: pip install -r requirements.txt
# 4. Start the bot: python main.py
#
# For Pydroid 3 on Android:
# 1. Copy .env.example to .env
# 2. Fill required values
# 3. Install requirements
# 4. Run: python main.py
#
# The application will fail to start if BOT_TOKEN, API_ID, or API_HASH 
# are not set. All other variables are optional with safe defaults.
#
# DO NOT commit the real .env file to version control.

# Partial hardening release defaults
LOGIN_TTL_SECONDS=600
ENABLE_EXPERIMENTAL_PLATFORMS=0
SUPPORT_GROUP_URL=
# Checkout/approval and paid auto-renewal remain disabled in this release.
